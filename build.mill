//| mill-version: 1.4.0-M2
//| mill-jvm-opts: ["-Xmx2g"]

package build

import mill.*
import mill.javalib.*
import mill.javalib.publish.*

object jdk22 extends JavaModule {
  def javacOptions = super.javacOptions() ++ Seq(
    "--release", "22"
  )
}

object `is-terminal` extends JavaModule with PublishModule {
  def pomSettings = PomSettings(
    description = artifactName(),
    organization = "io.github.alexarchambault",
    url = "https://github.com/alexarchambault/is-terminal",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("alexarchambault", "is-terminal"),
    developers = Seq(
      Developer("alexarchambault", "Alex Archambault", "https://github.com/alexarchambault")
    )
  )
  def publishVersion = Task {
    computePublishVersion()
  }

  // Almost empty javadoc JAR (only a manifest), Maven Central just requires one to be there
  def docJar = Task {
    PathRef(mill.util.Jvm.createJar(Task.dest / "out.jar", Seq.empty))
  }

  def javacOptions = super.javacOptions() ++ Seq(
    "--release", "8"
  )

  def jdk22ClassesResources = Task {
    val destDir = Task.dest / "META-INF/versions/22"
    os.makeDir.all(destDir)
    for (elem <- os.list(jdk22.compile().classes.path))
      os.copy(elem, destDir / elem.last)
    PathRef(Task.dest)
  }

  def resources = Task {
    super.resources() ++ Seq(jdk22ClassesResources())
  }
  def manifest = Task {
    super.manifest().add("Multi-Release" -> "true")
  }
}

/** Version deduced from the "v*" git tags: the tag value (minus "v") if HEAD has such a tag,
  * else the latest such tag, keeping only its first 3 '.'-separated elements, with its last
  * element incremented, and a "-SNAPSHOT" suffix
  */
def computePublishVersion = Task.Input {
  def git(args: String*): Seq[String] =
    os.proc("git", args)
      .call(cwd = mill.api.BuildCtx.workspaceRoot, check = false, stderr = os.Pipe)
      .out
      .lines()
      .map(_.trim)
      .filter(_.nonEmpty)

  val headTagVersions = git("tag", "--points-at", "HEAD")
    .filter(_.startsWith("v"))
    .map(_.stripPrefix("v"))

  headTagVersions.headOption.getOrElse {
    val latestTag = git("describe", "--tags", "--abbrev=0", "--match", "v*").headOption
      .getOrElse(sys.error("No 'v*' git tag found, cannot compute version"))
    val elems = latestTag.stripPrefix("v").split('.').toSeq.take(3)
    val lastNum = elems.last.toIntOption
      .getOrElse(sys.error(s"Cannot compute version from tag $latestTag"))
    (elems.init :+ (lastNum + 1).toString).mkString(".") + "-SNAPSHOT"
  }
}
